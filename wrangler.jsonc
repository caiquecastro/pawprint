{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pawprint",
  "compatibility_date": "2026-09-26",
  "compatibility_flags": ["nodejs_compat"],
  "main": "@tanstack/react-start/server-entry",
  "vars": {
    "CLERK_AUTHORIZED_PARTIES": "https://pawprint.pawprint.workers.dev",
  },
  "secrets": {
    "required": ["CLERK_SECRET_KEY"],
  },
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.01 },
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "pawprint-db",
      "database_id": "a26c5c8f-a496-4b6a-9926-8b8139f692b6",
      "migrations_dir": "migrations",
    },
  ],
  "r2_buckets": [{ "binding": "PHOTOS", "bucket_name": "pawprint-photos" }],
}
