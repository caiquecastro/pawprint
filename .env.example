# Public browser key from the Clerk dashboard.
VITE_CLERK_PUBLISHABLE_KEY=pk_test_replace_me

# Server-only values. Never prefix these with VITE_.
CLERK_SECRET_KEY=sk_test_replace_me

# Optional: enables networkless session-token verification.
# CLERK_JWT_KEY="-----BEGIN PUBLIC KEY-----\nreplace_me\n-----END PUBLIC KEY-----"

# Comma-separated origins allowed to mint session tokens for this app.
CLERK_AUTHORIZED_PARTIES=http://localhost:3000,https://pawprint.example.com
